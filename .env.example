# Run `node scripts/configure.mjs` to create .env with random values.
JWT_SECRET=
SETUP_TOKEN=
HOST_PORT=8080
# Set to 1 only behind exactly one trusted reverse proxy.
TRUST_PROXY=0
# Optional local OpenStreetMap directory: south,west,north,east. Empty disables imports.
SHOP_DIRECTORY_BBOX=
MAP_USER_AGENT=GroceryTracker/1.0
